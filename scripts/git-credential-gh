#!/usr/bin/env bash
# git credential helper: serves the autofix GitHub PAT, for github.com only.
# Called by git as: git-credential-gh get|store|erase
# Only "get" is implemented. git sends key=value lines on stdin; the helper
# answers only when the requested host is github.com.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

host=""
while IFS= read -r line; do
    case "$line" in
        host=*) host="${line#host=}" ;;
    esac
done
[ "$host" = "github.com" ] || exit 0

AUTOFIX_HOME="${AUTOFIX_HOME:-$HOME/.autofix}"
PAT_FILE="$AUTOFIX_HOME/creds/gh-pat"
GH_USER="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["gh_user"])' \
    "$AUTOFIX_HOME/config.json")"
[ -r "$PAT_FILE" ] || { echo "git-credential-gh: missing $PAT_FILE" >&2; exit 1; }

printf 'username=%s\n' "$GH_USER"
printf 'password=%s\n' "$(cat "$PAT_FILE")"
