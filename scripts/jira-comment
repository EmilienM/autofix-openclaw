#!/usr/bin/env bash
# usage: jira-comment KEY [TEXT]   (TEXT or stdin)
# Posts a plain-text comment on a Jira ticket. Exits 0 on success (201).
# curl is the HTTP client (OCSF fence); python3 only builds JSON.
set -euo pipefail

[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: jira-comment KEY [TEXT]" >&2; exit 2; }
KEY="$1"
TEXT="${2:-$(cat)}"
[[ $KEY =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || { echo "jira-comment: bad ticket key: $KEY" >&2; exit 2; }

AUTOFIX_HOME="${AUTOFIX_HOME:-$HOME/.autofix}"
CREDS="$AUTOFIX_HOME/creds/jira.env"
# shellcheck source=/dev/null
[ -r "$CREDS" ] || { echo "jira-comment: missing $CREDS" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CREDS"

BODY="$(python3 -c 'import json,sys; print(json.dumps({"body": sys.argv[1]}))' \
    "$TEXT")"

curl --silent --show-error --fail-with-body \
    -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
    -H 'Content-Type: application/json' \
    -X POST "$JIRA_URL/rest/api/2/issue/$KEY/comment" \
    -d "$BODY" || { echo "jira-comment: comment request failed for $KEY" >&2; exit 1; }
