#!/usr/bin/env bash
# usage: jira-label KEY add|remove LABEL
# Adds or removes a Jira label on a ticket. Exits 0 on success (204).
# curl is the HTTP client (OCSF fence); python3 only builds JSON.
set -euo pipefail

[ $# -eq 3 ] || { echo "usage: jira-label KEY add|remove LABEL" >&2; exit 2; }
KEY="$1"
OP="$2"
LABEL="$3"
case "$OP" in
    add | remove) ;;
    *) echo "jira-label: op must be add or remove" >&2; exit 2 ;;
esac
[[ $KEY =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || { echo "jira-label: bad ticket key: $KEY" >&2; exit 2; }

AUTOFIX_HOME="${AUTOFIX_HOME:-$HOME/.autofix}"
CREDS="$AUTOFIX_HOME/creds/jira.env"
# shellcheck source=/dev/null
[ -r "$CREDS" ] || { echo "jira-label: missing $CREDS" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CREDS"

BODY="$(python3 -c 'import json,sys
op = "add" if sys.argv[1] == "add" else "remove"
print(json.dumps({"update": {"labels": [{op: sys.argv[2]}]}}))' \
    "$OP" "$LABEL")"

curl --silent --show-error --fail-with-body \
    -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
    -H 'Content-Type: application/json' \
    -X PUT "$JIRA_URL/rest/api/3/issue/$KEY" \
    -d "$BODY" || { echo "jira-label: label request failed for $KEY" >&2; exit 1; }
